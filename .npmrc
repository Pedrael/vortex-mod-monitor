# Vortex provides React, react-select, react-bootstrap et al. at RUNTIME; they are
# peerDependencies of @nexusmods/vortex-api and exist here only so `tsc` can resolve
# types. Nothing from node_modules is bundled — this extension ships dist/ + index.js
# + info.json, and every vortex-api peer stays external.
#
# @nexusmods/vortex-api@2.6.0-beta.2 pins react@18.3.1 while also pinning
# react-select@1.3.0, whose peer range stops at React 16 — mutually unsatisfiable under
# npm's strict peer resolution. Upstream builds Vortex with pnpm, which only warns.
# The conflict is therefore type-time noise with no runtime consequence here.
#
# Revisit when 2.6.0 goes stable (react-select may be dropped or bumped).
legacy-peer-deps=true
