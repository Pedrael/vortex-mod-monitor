{
  "compilerOptions": {
    "target": "ES2019",
    "module": "commonjs",
    "moduleResolution": "node",
    // @nexusmods/vortex-api exposes its types only through package.json "exports",
    // which Node10 resolution cannot read. Emit must stay CommonJS for Vortex, and
    // "node16" resolution forces ESM/CJS interop + explicit extensions (64 errors),
    // so map the package directly — the same approach the official MIGRATION.md
    // recommends for the `collections` types.
    "paths": {
      "@nexusmods/vortex-api": ["./node_modules/@nexusmods/vortex-api/lib/api.d.ts"]
    },
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react",
    "lib": ["ES2019", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  // `.testutil.ts` holds fixtures and builders used only by tests. Excluded for
  // the same reason as the tests themselves: it is dead weight in the shipped
  // plugin, and a helper that writes deliberately malformed archives has no
  // business inside a user's Vortex install.
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.testutil.ts"
  ]
}
